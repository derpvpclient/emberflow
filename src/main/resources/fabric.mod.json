{
	"schemaVersion": 1,
	"id": "emberflow",
	"version": "${version}",
	"name": "Emberflow",
	"description": "Optimizes Minecraft with Vitrail on Vulkan: faster mobs and mob shadows, without changing the image.",
	"authors": [
		"derpvpclient"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://modrinth.com/mod/emberflow",
		"issues": "https://github.com/derpvpclient/emberflow/issues",
		"sources": "https://github.com/derpvpclient/emberflow"
	},
	"icon": "assets/emberflow/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.derpvpclient.emberflow.EmberflowClient"
		],
		"modmenu": [
			"de.derpvpclient.emberflow.EmberflowModMenu"
		],
		"sodium:config_api_user": [
			"de.derpvpclient.emberflow.EmberflowSodiumPage"
		]
	},
	"mixins": [
		{
			"config": "emberflow.sodium.mixins.json",
			"environment": "client"
		},
		{
			"config": "emberflow.vitrail.mixins.json",
			"environment": "client"
		},
		{
			"config": "emberflow.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/emberflow",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/emberflow"
			}
		}
	}
}
